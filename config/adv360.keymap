#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        swedish_a: swedish_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(U) &kp A>;
            label = "SWEDISH_A";
        };

        swedish_o: swedish_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(U) &kp O>;
            label = "SWEDISH_O";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp N1        &kp N2            &kp N3    &kp N4     &kp N5  &kp PLUS                                                                            &kp LS(LG(NUMBER_4))  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q         &kp W             &kp E     &kp R      &kp T   &kp MINUS                                                                           &kp LA(LC(LG(N2)))    &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&mo 1       &kp A         &kp S             &kp D     &kp F      &kp G   &kp EQUAL  &kp LG(ESC)       &kp LG(END)      &kp LG(LC(LA(C)))  &kp LA(LC(LG(R)))  &kp LA(LC(LG(N3)))    &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z         &kp X             &kp C     &kp V      &kp B                                &mo 2            &kp PG_UP                                                   &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL   &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LEFT  &kp RIGHT          &kp SPACE  &kp LEFT_COMMAND  &mo 1            &kp PG_DN          &kp ENTER          &kp BACKSPACE                 &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &kp TILDE
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4              &kp F5         &kp F6  &trans                                      &trans  &kp F7  &kp F8            &kp F9              &kp F10         &kp F11          &kp F12
&trans  &trans  &trans  &trans              &trans         &trans  &trans                                      &trans  &trans  &trans            &trans              &trans          &trans           &kp LG(A)
&trans  &trans  &trans  &trans              &trans         &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans            &trans              &trans          &swedish_o       &swedish_a
&trans  &trans  &trans  &trans              &trans         &trans                  &trans      &trans                  &trans  &trans            &trans              &trans          &trans           &trans
&trans  &trans  &trans  &kp LG(LEFT_ARROW)  &kp LG(RIGHT)          &trans  &trans  &trans      &trans  &trans  &trans          &kp LG(UP_ARROW)  &kp LG(DOWN_ARROW)  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4     &trans                                                    &trans        &trans  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&trans          &trans        &trans        &trans        &trans         &trans           &bootloader                                               &bootloader        &trans  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&studio_unlock  &trans        &bl BL_INC    &bl BL_DEC    &bl BL_TOG     &rgb_ug RGB_TOG  &stp STP_BAT  &trans  &trans      &bt BT_CLR  &trans      &stp STP_BAT  &trans  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&trans          &trans        &trans        &trans        &macro_ver     &rgb_ug RGB_TOG                        &trans      &trans                                &trans  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&trans          &trans        &trans        &kp LA(LEFT)  &kp LA(RIGHT)                   &trans        &trans  &trans      &trans      &bl BL_TOG  &kp KP_N0             &kp LA(UP)  &kp LA(DOWN)  &kp KP_DOT     &trans           &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                                   &trans           &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &bootloader                                              &bootloader      &trans  &trans      &trans      &trans  &trans  &trans
&studio_unlock  &trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans      &bt BT_CLR  &trans      &stp STP_BAT     &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &macro_ver    &trans                             &trans      &trans                                   &trans  &trans      &trans      &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                      &trans       &trans  &trans      &trans      &bl BL_TOG  &rgb_ug RGB_TOG          &bl BL_INC  &bl BL_DEC  &trans  &trans  &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
